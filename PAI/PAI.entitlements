<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>production</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:pai.frederikberg.com</string>
	</array>
	<!-- The app's own group stays first: that is where a write with no group lands, so the
	     backend token stays where it has always been. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<string>$(PAI_SHARED_KEYCHAIN_GROUP)</string>
	</array>
</dict>
</plist>
