<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps the microphone running after the app leaves the screen, so a take started here
	     survives the Home button, another app, and the lock screen. iOS suspends an ordinary app
	     within seconds of backgrounding regardless of what it has open, so without this a
	     recording ends the moment Freddy looks at something else — which is the entire reason
	     recording on the phone beats recording in the browser.

	     Declared in a real Info.plist rather than as an INFOPLIST_KEY_ build setting: that
	     mechanism is what Xcode's own Background Modes capability writes, and whether the build
	     setting form reaches an array-valued key is exactly the kind of thing that fails silently
	     and looks like an OS restriction. The Mac workflow asserts this survives into the built
	     app, alongside a generated key, so a merge that dropped either one fails the build.

	     `remote-notification` is the second mode here, for an entirely different reason: it is
	     what lets a silent (content-available) push wake the app at all — Apple drops one
	     outright for an app that never declared this. Without it a backgrounded phone's badge
	     and delivered notifications simply never correct themselves when read elsewhere, which
	     reads as the read-sync push not working rather than as a missing declaration. Unlike
	     `audio`, this grants no continuous background execution — only a brief wake window when
	     a push actually arrives — so it needs no audit of what else runs in the background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>

	<!-- `pai://session/<id>` and `pai://note/<id>`, so a Shortcuts action or a widget can open
	     one screen directly. Array-valued and nested two levels, so it has the same reason to
	     live here rather than in an INFOPLIST_KEY_ build setting as the background mode above.

	     A scheme the system does not know about is not an error — it is a link that silently
	     opens nothing, which reads as a broken shortcut rather than a missing declaration. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.frederikberg.pai.deeplink</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pai</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
