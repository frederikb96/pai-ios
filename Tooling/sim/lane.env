# What the simulator scripts need to know about this app.
PROJECT=PAI.xcodeproj
SCHEME=PAI
BUNDLE=com.frederikberg.pai

after_boot() {
  # The app is used in dark mode, and every design judgement made from a light screenshot is a
  # judgement about a screen nobody looks at.
  xcrun simctl ui "$1" appearance dark
}

after_install() {
  # A call tile's own screenshot arms dictation on entry; without a grant its screenshot is the
  # system permission prompt rather than the screen.
  xcrun simctl privacy "$1" grant microphone "$BUNDLE"
}
